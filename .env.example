# Crunchyroll Downloader — Environment Configuration
# Copy this file to .env and fill in your values.

# Crunchyroll session cookie (etp_rt). Required for authentication.
# CRUNCHYROLL_ETP_RT=your_etp_rt_cookie_value_here

# Path to the Widevine device file (.wvd).
# WIDEVINE_DEVICE_PATH=/path/to/device.wvd

# Path to the Widevine client ID binary (must be paired with WIDEVINE_PRIVATE_KEY_PATH).
# WIDEVINE_CLIENT_ID_PATH=/path/to/client_id.bin

# Path to the Widevine private key (must be paired with WIDEVINE_CLIENT_ID_PATH).
# WIDEVINE_PRIVATE_KEY_PATH=/path/to/private_key.pem

# Override the config directory (default: ~/.config/animeheaven).
# XDG_CONFIG_HOME=/custom/config/path

# Custom output directory for downloaded files.
# OUTPUT_DIR=/path/to/downloads
